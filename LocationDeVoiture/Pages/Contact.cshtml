@page
@model LocationDeVoiture.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}

<section class="page-hero">
    <div class="hero-content">
        <h1>Contactez-nous</h1>
        <p>Notre équipe est là pour vous aider</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="contact-info-card">
                <h3>Nos coordonnées</h3>
                
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <h5>Siège social</h5>
                        <p>123 Boulevard Mohammed V<br>20000 Casablanca, Maroc</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <h5>Téléphone</h5>
                        <p>+212 5 22 XX XX XX<br>+212 5 22 XX XX XX</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="bi bi-whatsapp"></i>
                    </div>
                    <div>
                        <h5>WhatsApp</h5>
                        <p>+212 6 XX XX XX XX</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <h5>Email</h5>
                        <p>contact@autorent.ma<br>reservations@autorent.ma</p>
                    </div>
                </div>
                
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="bi bi-clock-fill"></i>
                    </div>
                    <div>
                        <h5>Horaires</h5>
                        <p>Lun - Sam : 8h00 - 20h00<br>Dim : 9h00 - 18h00</p>
                    </div>
                </div>
                
                <div class="social-links mt-4">
                    <a href="#" class="social-link"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>
        </div>
        
        <div class="col-lg-7">
            @if (Model.MessageEnvoye)
            {
                <div class="success-card">
                    <div class="success-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h3>Message envoyé !</h3>
                    <p>Merci de nous avoir contacté. Notre équipe vous répondra dans les plus brefs délais.</p>
                    <a href="/Contact" class="btn btn-primary mt-3">Envoyer un autre message</a>
                </div>
            }
            else
            {
                <div class="contact-form-card">
                    <h3>Envoyez-nous un message</h3>
                    <p class="text-muted">Remplissez le formulaire ci-dessous et nous vous répondrons rapidement.</p>
                    
                    <form method="post" class="mt-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Contact.Nom" class="form-label"></label>
                                <input asp-for="Contact.Nom" class="form-control" placeholder="Votre nom" />
                                <span asp-validation-for="Contact.Nom" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Contact.Email" class="form-label"></label>
                                <input asp-for="Contact.Email" class="form-control" type="email" placeholder="votre@email.com" />
                                <span asp-validation-for="Contact.Email" class="text-danger"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Contact.Sujet" class="form-label"></label>
                                <select asp-for="Contact.Sujet" class="form-select">
                                    <option value="">Sélectionnez un sujet</option>
                                    <option value="Réservation">Question sur une réservation</option>
                                    <option value="Tarifs">Demande de devis / Tarifs</option>
                                    <option value="Réclamation">Réclamation</option>
                                    <option value="Partenariat">Partenariat</option>
                                    <option value="Autre">Autre</option>
                                </select>
                                <span asp-validation-for="Contact.Sujet" class="text-danger"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Contact.Message" class="form-label"></label>
                                <textarea asp-for="Contact.Message" class="form-control" rows="5" placeholder="Votre message..."></textarea>
                                <span asp-validation-for="Contact.Message" class="text-danger"></span>
                            </div>
                            
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-send"></i> Envoyer le message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
    
    <div class="map-section mt-5">
        <h3 class="text-center mb-4">Nos agences au Maroc</h3>
        <div class="map-container">
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3323.846454690948!2d-7.6192!3d33.5731!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda7cd4778aa113b%3A0xb06c1d84f310fd3!2sCasablanca!5e0!3m2!1sfr!2sma!4v1635000000000!5m2!1sfr!2sma" 
                width="100%" 
                height="400" 
                style="border:0; border-radius: 16px;" 
                allowfullscreen="" 
                loading="lazy">
            </iframe>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
