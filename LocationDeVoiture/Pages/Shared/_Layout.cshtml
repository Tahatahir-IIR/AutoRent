<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoRent Maroc</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <i class="bi bi-car-front-fill"></i>
                    <span>Auto<span class="accent">Rent</span></span>
                    <small class="brand-country">Maroc</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house"></i> Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Voitures/Index">
                                <i class="bi bi-car-front"></i> Nos Véhicules
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Reservation">
                                    <i class="bi bi-calendar-check"></i> Réserver
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/MesReservations">
                                    <i class="bi bi-list-check"></i> Mes Réservations
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Contact">
                                <i class="bi bi-envelope"></i> Contact
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link admin-link" asp-page="/Admin/Index">
                                    <i class="bi bi-speedometer2"></i> Admin
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="nav-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="user-menu dropdown">
                                <button class="btn btn-outline-accent dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name?.Split('@')[0]
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/MesReservations"><i class="bi bi-list-check"></i> Mes réservations</a></li>
                                    <li><a class="dropdown-item" href="/Account/MesCartes"><i class="bi bi-credit-card"></i> Mes cartes</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" href="/Admin"><i class="bi bi-speedometer2"></i> Administration</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="/Account/Logout">
                                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-outline-accent me-2">
                                <i class="bi bi-box-arrow-in-right"></i> Connexion
                            </a>
                            <a href="/Account/Register" class="btn btn-accent">
                                <i class="bi bi-person-plus"></i> Inscription
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-main">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="footer-brand">
                            <a href="/">
                                <i class="bi bi-car-front-fill"></i>
                                <span>Auto<span class="accent">Rent</span> Maroc</span>
                            </a>
                            <p>Votre partenaire de confiance pour la location de véhicules au Maroc depuis 2010. Qualité, service et prix imbattables.</p>
                            <div class="social-links">
                                <a href="#"><i class="bi bi-facebook"></i></a>
                                <a href="#"><i class="bi bi-instagram"></i></a>
                                <a href="#"><i class="bi bi-whatsapp"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <h5>Navigation</h5>
                        <ul class="footer-links">
                            <li><a href="/">Accueil</a></li>
                            <li><a href="/Voitures">Nos Véhicules</a></li>
                            <li><a href="/Reservation">Réservation</a></li>
                            <li><a href="/Contact">Contact</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <h5>Nos agences</h5>
                        <ul class="footer-links">
                            <li><a href="#">Casablanca</a></li>
                            <li><a href="#">Marrakech</a></li>
                            <li><a href="#">Rabat</a></li>
                            <li><a href="#">Agadir</a></li>
                            <li><a href="#">Fès</a></li>
                            <li><a href="#">Tanger</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <h5>Contact</h5>
                        <ul class="footer-contact">
                            <li>
                                <i class="bi bi-geo-alt"></i>
                                <span>123 Boulevard Mohammed V, Casablanca</span>
                            </li>
                            <li>
                                <i class="bi bi-telephone"></i>
                                <span>+212 5 22 XX XX XX</span>
                            </li>
                            <li>
                                <i class="bi bi-whatsapp"></i>
                                <span>+212 6 XX XX XX XX</span>
                            </li>
                            <li>
                                <i class="bi bi-envelope"></i>
                                <span>contact@autorent.ma</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    <p class="mb-0">&copy; 2025 AutoRent Maroc. Tous droits réservés.</p>
                    <div class="footer-bottom-links">
                        <a href="#">Mentions légales</a>
                        <a href="#">CGV</a>
                        <a href="#">Confidentialité</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
