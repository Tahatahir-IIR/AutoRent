@page
@model LocationDeVoiture.Pages.Voitures.IndexModel
@{
    ViewData["Title"] = "Nos Véhicules";
}

<section class="page-hero">
    <div class="hero-content">
        <h1>Notre Flotte</h1>
        <p>Découvrez notre sélection de véhicules pour explorer le Maroc</p>
    </div>
</section>

<div class="container py-5">
    <div class="row">
        <!-- Filtres -->
        <div class="col-lg-3 mb-4">
            <div class="filter-card">
                <h4><i class="bi bi-funnel"></i> Filtres</h4>
                <form method="get">
                    <div class="mb-3">
                        <label class="form-label">Recherche</label>
                        <input type="text" class="form-control" name="Recherche" value="@Model.Recherche" placeholder="Marque, modèle...">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Catégorie</label>
                        <select class="form-select" name="Categorie">
                            <option value="">Toutes</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat" selected="@(Model.Categorie == cat)">@cat</option>
                            }
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Prix par jour (MAD)</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control" name="PrixMin" value="@Model.PrixMin" placeholder="Min">
                            <input type="number" class="form-control" name="PrixMax" value="@Model.PrixMax" placeholder="Max">
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                    <a href="/Voitures" class="btn btn-outline-secondary w-100 mt-2">Réinitialiser</a>
                </form>
            </div>
        </div>
        
        <!-- Liste des voitures -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0">@Model.Voitures.Count véhicule(s) trouvé(s)</p>
            </div>
            
            @if (Model.Voitures.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-car-front"></i>
                    <h4>Aucun véhicule trouvé</h4>
                    <p>Essayez de modifier vos critères de recherche</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var voiture in Model.Voitures)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="car-card">
                                <div class="car-image">
                                    <img src="@voiture.ImageUrl" alt="@voiture.Marque @voiture.Modele" onerror="this.src='https://via.placeholder.com/400x250?text=Pas+d%27image'">
                                    <span class="car-category">@voiture.Categorie</span>
                                </div>
                                <div class="car-body">
                                    <h5>@voiture.Marque @voiture.Modele</h5>
                                    <p class="car-year">@voiture.Annee</p>
                                    
                                    <div class="car-features">
                                        <span><i class="bi bi-fuel-pump"></i> @voiture.Carburant</span>
                                        <span><i class="bi bi-gear"></i> @voiture.Transmission</span>
                                        <span><i class="bi bi-people"></i> @voiture.NombrePlaces places</span>
                                    </div>
                                    
                                    <div class="car-footer">
                                        <div class="car-price">
                                            <span class="price">@voiture.PrixParJour.ToString("N0") MAD</span>
                                            <span class="period">/ jour</span>
                                        </div>
                                        <a href="/Voitures/Details/@voiture.Id" class="btn btn-primary btn-sm">
                                            Voir détails
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
